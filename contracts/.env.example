# RPC URLs
SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_RPC_URL=
MAINNET_RPC_URL=

# Explorer verification
ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=

# Required deployment addresses
S_MAX=1000000000000000000000000000
COMMUNITY_PROGRAM_OWNER=
TREASURY_ADDRESS=
TEAM_BENEFICIARY=
INVESTOR_BENEFICIARY=
LIQUIDITY_ADDRESS=
OWNER_ADDRESS=

# Optional deployment signer.
# Leave unset to use the currently configured Foundry broadcaster.
# Never commit a real private key.
DEPLOYER_PRIVATE_KEY=

# Protocol parameters
# Optional initial allowlist entry. Leave as zero for no eligible verifier at deployment;
# the final owner can later call setOfficialVerifier(address, true).
OFFICIAL_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000
VERIFIER_MINIMUM_STAKE=1000000000000000000000
VERIFIER_UNBONDING_DELAY=1296000
SOLVER_BOND=10000000000000000000
VERIFIER_REWARD_BPS=200
TREASURY_BURN_BPS=2000
DEFAULT_SOLVER_ACCESS_REWARD_BPS=100
SOLVER_ROYALTY_BPS=5000

# Required only for Ethereum mainnet or Arbitrum One deployments.
PRODUCTION_DEPLOYMENT_APPROVED=false

# Dedicated Arbitrum Sepolia three-contract migration
# Required safety acknowledgement and public signer address. Supply signing credentials to
# Foundry through an encrypted keystore, hardware wallet, or hidden interactive prompt.
MIGRATION_BROADCAST_APPROVED=false
MIGRATION_DEPLOYER_ADDRESS=

# These two values are intentionally required so the launch stake policy is explicit.
MIGRATION_OFFICIAL_VERIFIER_ADDRESS=
MIGRATION_VERIFIER_MINIMUM_STAKE=

# Staking is opt-in. When true, the official verifier must be the deployer and the amount
# must be at least MIGRATION_VERIFIER_MINIMUM_STAKE.
MIGRATION_STAKE_OFFICIAL_VERIFIER=false
MIGRATION_OFFICIAL_VERIFIER_STAKE_AMOUNT=0
MIGRATION_OFFICIAL_VERIFIER_METADATA_URI=

# The script defaults to the reviewed current Arb Sepolia SAT, router, USDC, admin, and treasury.
# Address overrides are rejected unless MIGRATION_ALLOW_ADDRESS_OVERRIDE=true.
MIGRATION_ALLOW_ADDRESS_OVERRIDE=false
MIGRATION_SAT_TOKEN_ADDRESS=0x8Fe0e3557773B200995608a43691f3dE9B2e3Fda
MIGRATION_TREASURY_ROUTER_ADDRESS=0x841cD322a95287927a1Abaf6130007659Cc0672E
MIGRATION_USDC_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
MIGRATION_LEGACY_BOUNTY_MANAGER_ADDRESS=0x942b326B190d588fE1bb3931502f509c9f9eC767
MIGRATION_EXPECTED_LEGACY_NEXT_BOUNTY_ID=12
MIGRATION_FINAL_OWNER_ADDRESS=0x721b097821EbA304CAd6B43115283081899080ba
MIGRATION_EXPECTED_TREASURY_ADDRESS=0x721b097821EbA304CAd6B43115283081899080ba
MIGRATION_OUTPUT_PATH=deployments/arbitrum-sepolia-migration-421614.json
